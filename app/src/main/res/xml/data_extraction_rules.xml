<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Backup en la nube (Google Drive) — API 31+ -->
    <cloud-backup>
        <include domain="sharedpref" path="theme_preferences"/>
        <include domain="sharedpref" path="settings_preferences"/>
        <include domain="database" path="calendar_database"/>
        <include domain="database" path="calendar_database-wal"/>
        <include domain="database" path="calendar_database-shm"/>
        <include domain="file" path="backgrounds"/>
    </cloud-backup>
    <!-- Transferencia entre dispositivos (cable / migración) -->
    <device-transfer>
        <include domain="sharedpref" path="theme_preferences"/>
        <include domain="sharedpref" path="settings_preferences"/>
        <include domain="database" path="calendar_database"/>
        <include domain="database" path="calendar_database-wal"/>
        <include domain="database" path="calendar_database-shm"/>
        <include domain="file" path="backgrounds"/>
    </device-transfer>
</data-extraction-rules>
